      "source": [
        "## 온라인 송금 시스템 (Gradio)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "2d8bebd1"
      },
      "source": [
        "import gradio as gr\n",
        "\n",
        "# 초기 계좌 잔액 설정\n",
        "accounts = {\n",
        "    \"사용자 A\": 100000,  # 사용자 A의 초기 잔액 10만원\n",
        "    \"사용자 B\": 50000   # 사용자 B의 초기 잔액 5만원\n",
        "}\n",
        "\n",
        "def get_balances():\n",
        "    return f\"사용자 A 잔액: {accounts['사용자 A']}원\\n사용자 B 잔액: {accounts['사용자 B']}원\"\n",
        "\n",
        "def transfer_funds(sender, receiver, amount):\n",
        "    global accounts\n",
        "\n",
        "    if sender == receiver:\n",
        "        return \"송금 실패: 보내는 사람과 받는 사람이 같을 수 없습니다.\", get_balances()\n",
        "\n",
        "    if sender not in accounts or receiver not in accounts:\n",
        "        return \"송금 실패: 유효하지 않은 계좌입니다.\", get_balances()\n",
        "\n",
        "    try:\n",
        "        amount = int(amount)\n",
        "    except ValueError:\n",
        "        return \"송금 실패: 송금액은 숫자여야 합니다.\", get_balances()\n",
        "\n",
        "    if amount <= 0:\n",
        "        return \"송금 실패: 송금액은 양수여야 합니다.\", get_balances()\n",
        "\n",
        "    if accounts[sender] < amount:\n",
        "        return \"송금 실패: 잔액이 부족합니다.\", get_balances()\n",
        "\n",
        "    # 송금 처리\n",
        "    accounts[sender] -= amount\n",
        "    accounts[receiver] += amount\n",
        "\n",
        "    message = f\"{sender}님, {receiver}님에게 {amount}원이 성공적으로 송금되었습니다.\"\n",
        "    return message, get_balances()"
      ],
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "eccd3fd1"
      },
      "source": [
        "위 코드 블록에서는 송금 시스템의 핵심 로직을 정의합니다. `accounts` 딕셔너리에 두 사용자의 초기 잔액을 저장하고, `transfer_funds` 함수는 송금인, 수취인, 금액을 받아 잔액을 업데이트하고 송금 결과를 반환합니다. `get_balances` 함수는 현재 잔액 정보를 문자열로 반환합니다."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 652
        },
        "id": "1b184f80",
        "outputId": "7f8dac56-815c-4259-fa50-3893fcee329e"
      },
      "source": [
        "with gr.Blocks() as demo:\n",
        "    gr.Markdown(\"# Gradio 은행 온라인 송금 시스템\")\n",
        "\n",
        "    with gr.Row():\n",
        "        current_balances_output = gr.Textbox(label=\"현재 잔액\", value=get_balances(), interactive=False, lines=2)\n",
        "\n",
        "    with gr.Row():\n",
        "        sender_dropdown = gr.Dropdown(list(accounts.keys()), label=\"보내는 사람\")\n",
        "        receiver_dropdown = gr.Dropdown(list(accounts.keys()), label=\"받는 사람\")\n",
        "\n",
        "    amount_input = gr.Number(label=\"송금액 (원)\")\n",
        "    transfer_button = gr.Button(\"송금하기\")\n",
        "\n",
        "    transfer_status_output = gr.Textbox(label=\"송금 상태\", interactive=False)\n",
        "\n",
        "    transfer_button.click(\n",
        "        transfer_funds,\n",
        "        inputs=[sender_dropdown, receiver_dropdown, amount_input],\n",
        "        outputs=[transfer_status_output, current_balances_output]\n",
        "    )\n",
        "\n",
        "demo.launch()"
      ],
